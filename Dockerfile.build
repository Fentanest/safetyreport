# ARM64 PyInstaller 빌드용 Dockerfile
# ─────────────────────────────────────────────────────────────
# 빌드 + 결과물 추출 (한 줄):
#   docker buildx build --platform linux/arm64 -f Dockerfile.build \
#     --output type=local,dest=./dist-arm64 --target exporter .
#
# x86_64 호스트에서 ARM64 에뮬레이션이 필요한 경우 최초 1회 실행:
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
# ─────────────────────────────────────────────────────────────

# --platform은 빌드 커맨드에서 지정 (상수 플래그 경고 방지)
FROM python:3.14-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    && apt-get install -y upx-ucl 2>/dev/null || true \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY requirements.txt .
RUN pip install --no-cache-dir "pyinstaller>=6" -r requirements.txt

COPY . .

RUN python scripts/build/build_exe.py

# 결과물만 추출하기 위한 빈 스테이지
FROM scratch AS exporter
COPY --from=builder /build/dist/mysafetyreport /mysafetyreport
