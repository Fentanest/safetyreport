# ARM64 PyInstaller 빌드용 Dockerfile
# ─────────────────────────────────────────────────────────────
# 이미지 빌드 (소스 변경 시마다):
#   docker buildx build --platform linux/arm64 -f Dockerfile.build -t safetyreport-build .
#
# 결과물 추출 (./dist-arm64/ 에 자동 복사):
#   docker run --rm --platform linux/arm64 -v "$(pwd)/dist-arm64:/out" safetyreport-build
#
# x86_64 호스트에서 ARM64 에뮬레이션이 필요한 경우 최초 1회 실행:
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
# ─────────────────────────────────────────────────────────────

FROM --platform=linux/arm64 python:3.14-slim-bookworm

# PyInstaller 실행에 필요한 최소 패키지
RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    upx-ucl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY requirements.txt .
RUN pip install --no-cache-dir "pyinstaller>=6" -r requirements.txt

COPY . .

RUN python scripts/build/build_exe.py

# 컨테이너 실행 시 /out (호스트 마운트 경로)에 결과물 복사
CMD ["sh", "-c", "mkdir -p /out && cp -r /build/dist/mysafetyreport /out/ && echo '✓ dist-arm64에 복사 완료'"]
