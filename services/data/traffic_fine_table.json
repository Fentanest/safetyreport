{
  "metadata": {
    "schema_version": 1,
    "purpose": "금액 오타 후보 대조 전용; 추정 규칙/금액/분류를 정의하지 않음",
    "created_at": "2026-10-13",
    "effective_date": "2026-10-02",
    "decree": "대통령령 제36728호, 2026-09-29 타법개정",
    "source_url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290387&efYd=20261002",
    "sources": [
      {
        "annex": 6,
        "amended_at": "2025-03-18",
        "url": "https://www.law.go.kr/LSW/flDownload.do?flSeq=169705915&bylClsCd=110201",
        "sha256": "8787a18095474fd14344c993b432d112a6c5311866bf9782724d3fb3edb32414"
      },
      {
        "annex": 7,
        "amended_at": "2020-12-01",
        "url": "https://www.law.go.kr/LSW/flDownload.do?flSeq=169705941&bylClsCd=110201",
        "sha256": "bbf0fab6b5e19cee2cc158172df2078a7c1f880a41a950fc40a72370faf34972"
      }
    ],
    "normalization": "도로교통법 이름 또는 생략한 단일 조항만 허용; 공백 제거, 항·호의 제 생략 통일, 조/호의 의N 보존. 없는 하위 조항은 상위 조항으로 대체하지 않음. 상위 조·항의 includes는 확인된 하위 조항 합집합.",
    "vehicle_classes": {
      "승합등": "승합, 4톤 초과 화물, 특수, 건설기계, 노면전차",
      "승용등": "승용, 4톤 이하 화물",
      "이륜등": "이륜 및 원동기장치자전거; 개인형 이동장치 제외",
      "차종무관": "원문에 차종별 구분 없이 정한 금액; 행위자/적용 범위는 notes 참조",
      "개인형이동장치": "법 제50조제4항/별표6 제10호의 자전거 운전자 제외 대상; 이륜등과 구분"
    },
    "excluded": [
      "과태료 부과 근거인 제160조는 위반행위 조항이 아니므로 키로 사용하지 않음",
      "별표 8·10 범칙금, 감경·체납 가산금은 포함하지 않음"
    ],
    "supporting_law_url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=291133&efYd=20261013"
  },
