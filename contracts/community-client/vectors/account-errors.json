   "body": "{\"error\": {\"code\": \"auth_required\", \"message\": \"m\", \"requestTraceId\": \"t\", \"retryable\": false}}",
   "headers": {},
   "expect": {
    "success": false,
    "code": "auth_required",
    "transient": false,
    "retry_after_seconds": null,
    "auth": true
   }
  },
