   "name": "정책 불일치",
   "transport": null,
   "http_status": 409,
   "body": "{\"error\": {\"code\": \"policy_mismatch\", \"message\": \"m\", \"requestTraceId\": \"t\", \"retryable\": false, \"required_version\": \"2026-09-28.3\"}}",
   "headers": {},
   "expect": {
    "success": false,
