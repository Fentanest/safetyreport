{
 "description": "community-account HTTP 응답 분류(client-rules \u00a72). central_codes 는 중앙(auth account.ts)이 각 코드로 내는 HTTP 상태와 retryable 값.",
 "cases": [
  {
   "name": "성공",
   "transport": null,
   "http_status": 200,
   "body": "{\"protocol\": 1, \"gate\": {}}",
   "headers": {},
   "expect": {
    "success": true,
    "code": null,
    "transient": null,
    "retry_after_seconds": null,
    "auth": false
   }
  },
  {
   "name": "200 인데 error 키가 있으면 오류",
   "transport": null,
   "http_status": 200,
   "body": "{\"error\": {\"code\": \"busy\", \"message\": \"m\", \"requestTraceId\": \"t\", \"retryable\": true}}",
   "headers": {},
   "expect": {
    "success": false,
    "code": "busy",
    "transient": true,
    "retry_after_seconds": null,
    "auth": false
   }
  },
  {
   "name": "200 인데 최상위가 배열",
   "transport": null,
   "http_status": 200,
   "body": "[1]",
   "headers": {},
   "expect": {
    "success": false,
    "code": "server_error",
    "transient": false,
    "retry_after_seconds": null,
    "auth": false
   }
  },
  {
   "name": "인증 필요",
   "transport": null,
