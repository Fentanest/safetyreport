{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rating": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "rating_cause": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 10000
    },
    "survey_state": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "photo_first_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "photo_last_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "photo_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "report_date": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "entry_value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "ssnpc_cd": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 32
        },
        "ssnpc_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "title",
        "report_date",
        "status",
        "entry_value",
        "ssnpc_cd",
        "ssnpc_type"
      ]
    }
  },
  "required": [
    "rating",
    "rating_cause",
    "survey_state",
    "photo_first_at",
    "photo_last_at",
    "photo_count",
    "list"
  ]
}
