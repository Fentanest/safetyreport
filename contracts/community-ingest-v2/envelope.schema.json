{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safemap.worklazy.net/contracts/community-ingest-v2/envelope.json",
  "title": "community-ingest v2 raw envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "contract",
    "source_app",
    "source_mode",
    "connection_id",
    "consent_grant_id",
    "policy_version",
    "client_version",
    "parser_version",
    "trigger",
    "events"
  ],
  "properties": {
    "protocol": {
      "const": 2
    },
    "contract": {
      "const": "community-ingest-v2"
    },
    "source_app": {
      "enum": [
        "safetyreport",
        "safetyreport-mobile"
      ]
    },
    "source_mode": {
      "enum": [
        "server",
        "standalone"
      ]
    },
    "connection_id": {
      "type": "string",
      "format": "uuid"
    },
    "consent_grant_id": {
      "type": "string",
      "format": "uuid"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{1,3}$",
      "maxLength": 40
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "parser_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "trigger": {
      "enum": [
        "realtime",
        "manual",
        "midnight",
        "recovery",
        "rebuild",
        "reshare",
        "raw_backfill"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "event.schema.json"
      }
    }
  },
  "description": "한 요청의 events 는 source_report_id 가 모두 달라야 한다(같은 신고의 이벤트는 앞 요청의 ACK 뒤에 다음 요청으로). 서버는 어기면 422/schema_invalid. 문자열에 짝 없는 UTF-16 surrogate 가 있으면 422 로 거절한다."
}
